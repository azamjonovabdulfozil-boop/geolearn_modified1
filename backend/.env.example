# ══ BACKEND ENVIRONMENT NAMUNASI ══
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` fayli git'ga TUSHMAYDI — maxfiy kalitlar shu yerda saqlanadi.
#
# RENDER'DA bu faylni yuklamang! U yerda har bir qiymat
# Dashboard → Environment bo'limiga qo'lda qo'shiladi.

# ── Majburiy ────────────────────────────────────────────────────────────
# Server porti. Lokalda 3000. Render'da BU O'ZGARUVCHINI QO'YMANG —
# Render uni o'zi beradi.
PORT=3000

# JWT tokenlarini imzolash uchun maxfiy satr. Har bir muhitda O'ZGACHA
# va uzun bo'lsin. Yaratish:  openssl rand -hex 32
JWT_SECRET=

# CORS uchun ruxsat etilgan frontend manzillari (vergul bilan, / belgisiz).
# Bo'sh qoldirilsa — hamma manzilga ruxsat (faqat lokal ish uchun).
# Masalan: https://geolearn-admin.vercel.app,https://geolearn.vercel.app
FRONTEND_URL=

# ── Ixtiyoriy: AI yordamchisi ───────────────────────────────────────────
# Kamida bittasi bo'lsa AI ishlaydi; hech biri bo'lmasa AI o'chiq qoladi.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
LOVABLE_API_KEY=

# ── Ixtiyoriy: rejim ────────────────────────────────────────────────────
# api     → faqat API (Render uchun shu kerak)
# both    → 3000 va 3001 portlarda qurilgan saytlarni ham beradi (lokal)
SITE=api
